generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

enum ProductRequestStatus {
    DRAFT
    SEARCHING
    READY_FOR_REVIEW
    SELECTED
    FAILED
}

enum ComparisonStatus {
    NONE
    COMPARING
    READY
    FAILED
}

enum Marketplace {
    AMAZON
    ALIEXPRESS
}

model ProductRequest {
    id              String               @id @default(cuid())
    title           String
    description     String
    rationale       String
    status          ProductRequestStatus @default(DRAFT)
    agentId         String?
    lastRunId       String?
    lastRequestId   String?
    durationMs      Int?
    transcriptJson  String?
    selectedCandidateId String?
    comparisonStatus    ComparisonStatus @default(NONE)
    comparisonTableJson String?
    comparisonSummary   String?
    comparisonAgentId   String?
    createdAt       DateTime             @default(now())
    updatedAt       DateTime             @updatedAt
    candidates      ProductCandidate[]
    notifications   Notification[]
    agentEvents     AgentEvent[]

    @@index([status])
}

model ProductCandidate {
    id               String         @id @default(cuid())
    productRequestId String
    productRequest   ProductRequest @relation(fields: [productRequestId], references: [id], onDelete: Cascade)
    source           Marketplace
    title            String
    url              String
    price            String?
    currency         String?
    rating           Float?
    reviewCount      Int?
    reviewSummary    String
    pros             String?
    cons             String?
    imageUrl         String?
    rank             Int?
    createdAt        DateTime       @default(now())

    @@unique([productRequestId, url])
    @@index([productRequestId])
}

model Notification {
    id               String          @id @default(cuid())
    type             String
    message          String
    read             Boolean         @default(false)
    productRequestId String?
    productRequest   ProductRequest? @relation(fields: [productRequestId], references: [id], onDelete: Cascade)
    createdAt        DateTime        @default(now())

    @@index([read])
}

model AgentEvent {
    id               String         @id @default(cuid())
    productRequestId String
    productRequest   ProductRequest @relation(fields: [productRequestId], references: [id], onDelete: Cascade)
    runId            String?
    eventType        String
    label            String
    payload          String?
    createdAt        DateTime       @default(now())

    @@index([productRequestId])
}
